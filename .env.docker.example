# Copy to .env.docker (gitignored). These are the Nuxt NUXT_-prefixed runtime
# overrides of runtimeConfig.githubToken / runtimeConfig.githubUsername.

# Optional. Unauthenticated GitHub API access is limited to 60 req/h.
NUXT_GITHUB_TOKEN=

# Required for the GitHub-backed sections (projects, contributions, CV PDF).
NUXT_GITHUB_USERNAME=
