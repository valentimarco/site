{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site",
	"compatibility_date": "2026-07-10",
	"observability": {
		"traces": {
			"enabled": true
		},
		"enabled": true
	},
	"main": "./.output/server/index.mjs",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{ "pattern": "valentimarco.it/", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/blog*", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/api/*", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/_*", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/favicon.png", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/favicon.ico", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/me.webp", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/me-avatar.webp", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/me_jojo.webp", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/og-image.png", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/robots.txt", "zone_name": "valentimarco.it" },
		{ "pattern": "valentimarco.it/sitemap.xml", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/blog*", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/api/*", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/_*", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/favicon.png", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/favicon.ico", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/me.webp", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/me-avatar.webp", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/me_jojo.webp", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/og-image.png", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/robots.txt", "zone_name": "valentimarco.it" },
		{ "pattern": "www.valentimarco.it/sitemap.xml", "zone_name": "valentimarco.it" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-db",
			"database_id": "fcaf287c-41ba-4cf9-af4f-240278e0cdab"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "525d90c6f8744eb5a2742b0809d62c81"
		}
	]
}
