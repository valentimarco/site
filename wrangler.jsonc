{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site",
	"compatibility_date": "2026-07-10",
	"observability": {
		"traces": {
			"enabled": true
		},
		"enabled": true
	},
	"main": "./.output/server/index.mjs",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-db",
			"database_id": "fcaf287c-41ba-4cf9-af4f-240278e0cdab"
		}
	]
}
