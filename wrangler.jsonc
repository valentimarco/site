{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site",
	"compatibility_date": "2026-07-10",
	"observability": {
		"traces": {
			"enabled": true
		},
		"enabled": true
	},
	"main": "./.output/server/index.mjs",
	// Static assets for the Worker: Nitro bakes the same block into .output/server/wrangler.json.
	// Without it `wrangler deploy` uploads no files at all and the Worker answers asset requests
	// (_nuxt/*, _fonts/*, images) with empty 200 responses that the CDN then caches for 4h.
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Routing to valentimarco.it is intentionally detached while the final content is added.
	// Re-add the scoped routes (see AGENTS.md, "Cloudflare / Deployment") and rebuild to re-attach.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-db",
			"database_id": "fcaf287c-41ba-4cf9-af4f-240278e0cdab"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "525d90c6f8744eb5a2742b0809d62c81"
		}
	]
}
