# Local development secrets for `nuxt dev` (loaded by nitro-cloudflare-dev).
# Copy to `.env` and fill in your GitHub token (https://github.com/settings/tokens).
# Optional: GitHub API runs unauthenticated if unset (60 req/h limit).
GITHUB_TOKEN=

# Bypass the 1h edge cache on /api/cv-pdf while iterating on the PDF layout.
# Set to true to disable the cache; leave unset in production.
NUXT_CV_PDF_DISABLE_CACHE=
